PORT=5000
MONGO_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/luxeher
JWT_SECRET=change_this_to_a_long_random_string
# comma separated frontend URLs allowed by CORS
CLIENT_URL=http://localhost:5173
# delivery rules (in rupees)
FREE_DELIVERY_MIN=999
DELIVERY_FEE=79
# Cloudinary (strongly recommended on Render - local uploads get deleted on every redeploy)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# used by: npm run create-admin
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@luxeher.in
ADMIN_PASSWORD=ChangeMe@123
